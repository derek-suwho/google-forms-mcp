# Required for the remote Claude/ChatGPT connector.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_FORMS_CONNECTOR_TOKEN=

# Google OAuth files. Defaults are under ~/.config/google-forms-mcp/.
GOOGLE_FORMS_CLIENT_SECRET=
GOOGLE_FORMS_TOKEN=
# Persistent SQLite draft history. Defaults beside the Google token file.
GOOGLE_FORMS_DRAFT_DB=
# Private HMAC key file for binding approvals to immutable update plans.
GOOGLE_FORMS_CONFIRMATION_KEY=

GOOGLE_FORMS_CONNECTOR_HOST=0.0.0.0
# Comma-separated external Host headers accepted by the MCP endpoint.
GOOGLE_FORMS_CONNECTOR_PUBLIC_HOSTS=forms.example.com
PORT=8000

# Multi-user public product mode.
GOOGLE_FORMS_MULTIUSER=false
GOOGLE_FORMS_PUBLIC_BASE_URL=https://forms.example.com
GOOGLE_FORMS_WEB_CLIENT_SECRET=
# Alternative to a mounted Web client JSON file:
GOOGLE_FORMS_WEB_CLIENT_ID=
GOOGLE_FORMS_WEB_CLIENT_SECRET_VALUE=
GOOGLE_FORMS_GOOGLE_PROJECT_ID=
GOOGLE_FORMS_MULTIUSER_DATA_DIR=
GOOGLE_FORMS_USERS_DB=
GOOGLE_FORMS_MASTER_KEY=
GOOGLE_FORMS_RATE_LIMIT_PER_MINUTE=60
GOOGLE_FORMS_PUBLIC_RATE_LIMIT_PER_MINUTE=10
GOOGLE_FORMS_PUBLIC_GLOBAL_RATE_LIMIT_PER_MINUTE=120
# Enable only when all public traffic arrives through a trusted proxy that overwrites client-IP headers.
GOOGLE_FORMS_TRUST_PROXY_HEADERS=false
